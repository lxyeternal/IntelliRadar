{
    "comment": "Download manager configuration - all paths and URLs should be configured here",
    
    "storage": {
        "base_dir": "packages",
        "subdirs": {
            "pypi": "pypi",
            "npm": "npm",
            "nuget": "nuget"
        }
    },
    
    "pypi_mirrors": {
        "tsinghua": "https://pypi.tuna.tsinghua.edu.cn/",
        "tencent": "http://mirrors.cloud.tencent.com/pypi/",
        "douban": "http://pypi.doubanio.com/"
    },
    
    "npm_mirrors": {
        "taobao": "https://registry.npmmirror.com/",
        "huawei": "https://mirrors.huaweicloud.com/repository/npm/",
        "tencent": "http://mirrors.cloud.tencent.com/npm/",
        "cnpmjs": "https://r.cnpmjs.org/"
    },
    
    "nuget_mirrors": {
        "huawei": "https://mirrors.huaweicloud.com/repository/nuget/v3/registration5-semver1/{}/index.json"
    },
    
    "download_settings": {
        "timeout_seconds": 60,
        "max_retries": 3,
        "max_package_size_mb": 500,
        "max_wildcard_versions": 10
    },
    
    "pypi_settings": {
        "simple_path": "simple",
        "valid_extensions": [".tar.gz", ".zip", ".whl"],
        "strip_suffixes": [
            "-py3-none-any",
            "-py2.py3-none-any",
            ".tar.gz",
            ".zip",
            ".whl"
        ]
    },
    
    "npm_settings": {
        "scope_separator": "##"
    },
    
    "nuget_settings": {
        "scope_separator": "##"
    }
}