# IntelliRadar Environment Configuration
# Copy this file to .env and update the values

# MongoDB Configuration
MONGODB_URI=mongodb://admin:intelliradar2024@localhost:27017/intelliradar?authSource=admin
MONGODB_DATABASE=intelliradar

# MongoDB Authentication
MONGODB_USERNAME=admin
MONGODB_PASSWORD=intelliradar2024

# Application User (for the app to connect to MongoDB)
MONGODB_APP_USERNAME=intelliradar_app
MONGODB_APP_PASSWORD=app_password_2024

# Crawler Configuration
REQUEST_DELAY=2
TIMEOUT=30
MAX_WORKERS=3
ENABLE_CONTENT_PROCESSING=true

# Chrome/Selenium Configuration
CHROME_BIN=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
HEADLESS=true

# LLM Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/intelliradar.log

# Docker Configuration
COMPOSE_PROJECT_NAME=intelliradar

# Optional: Redis Configuration (for future caching)
REDIS_URL=redis://localhost:6379

# Optional: Email Notifications (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=admin@yourdomain.com

# Security
SECRET_KEY=your_secret_key_here_change_in_production

# Development/Production Mode
ENVIRONMENT=development
DEBUG=false
