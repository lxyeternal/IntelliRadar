{
  "data_sources": {
    "unstructured": {
      "description": "非结构化数据源，需要LLM分析",
      "sources": [
        {
          "name": "snyk",
          "enabled": true,
          "collection_method": "snyk_blog",
          "requires_llm": true
        },
        {
          "name": "github_blog",
          "enabled": true,
          "collection_method": "github_blog", 
          "requires_llm": true
        },
        {
          "name": "threatpost",
          "enabled": true,
          "collection_method": "threatpost_blog",
          "requires_llm": true
        },
        {
          "name": "darkreading",
          "enabled": true,
          "collection_method": "darkreading_blog",
          "requires_llm": true
        },
        {
          "name": "securityweek",
          "enabled": true,
          "collection_method": "securityweek_blog",
          "requires_llm": true
        },
        {
          "name": "bleepingcomputer",
          "enabled": true,
          "collection_method": "bleepingcomputer_blog",
          "requires_llm": true
        },
        {
          "name": "krebsonsecurity",
          "enabled": true,
          "collection_method": "krebsonsecurity_blog",
          "requires_llm": true
        }
      ]
    },
    "structured": {
      "description": "结构化数据源，可直接处理",
      "sources": [
        {
          "name": "osv",
          "enabled": true,
          "collection_method": "osv_api",
          "requires_llm": false,
          "api_endpoint": "https://osv.dev/",
          "data_format": "json"
        },
        {
          "name": "github_advisory",
          "enabled": true,
          "collection_method": "github_advisory_api",
          "requires_llm": false,
          "api_endpoint": "https://api.github.com/advisories",
          "data_format": "json"
        },
        {
          "name": "snyk_vulndb",
          "enabled": true,
          "collection_method": "snyk_vulndb_api", 
          "requires_llm": false,
          "api_endpoint": "https://snyk.io/vuln/",
          "data_format": "json"
        }
      ]
    }
  },
  "pipeline_settings": {
    "max_concurrent_requests": 5,
    "retry_attempts": 3,
    "delay_between_requests": 1,
    "llm_model": "gpt-4o",
    "llm_temperature": 0.1,
    "output_format": "csv",
    "enable_deduplication": true,
    "update_frontend": true
  },
  "paths": {
    "waiting_collection": "Dataset/waiting_collection.txt",
    "content_dir": "Dataset/Content/",
    "llm_output_dir": "Dataset/LLM-Output/",
    "csv_output": "Dataset/CSV/integrity.csv",
    "frontend_dir": "frontend/",
    "logs_dir": "logs/"
  },
  "processing_steps": {
    "unstructured_flow": [
      "collect_links",
      "extract_content", 
      "llm_analysis",
      "aggregate_data",
      "update_frontend"
    ],
    "structured_flow": [
      "fetch_structured_data",
      "normalize_data",
      "aggregate_data", 
      "update_frontend"
    ]
  }
}